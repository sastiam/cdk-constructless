      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "GuardMonitorB3D64E46": {
      "Properties": {
        "MonitorDimension": "SERVICE",
        "MonitorName": "TestStackGuardB5AC401C",
        "MonitorType": "DIMENSIONAL",
      },
      "Type": "AWS::CE::AnomalyMonitor",
    },
    "GuardSubscription0EAC9207": {
      "Properties": {
        "Frequency": "DAILY",
        "MonitorArnList": [
          {
            "Fn::GetAtt": [
              "GuardMonitorB3D64E46",
              "MonitorArn",
            ],
          },
        ],
        "Subscribers": [
          {
